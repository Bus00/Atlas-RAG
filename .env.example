# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Sonra kendi ortamınıza göre değerleri düzenleyin.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=maritime_rag
PG_USER=postgres
PG_PASSWORD=postgres

# --- Embedding (lokal, sentence-transformers üzerinden) ---
EMBEDDING_MODEL=BAAI/bge-m3
# Apple Silicon (M1/M2/M3/M4) için mps, GPU yoksa cpu yazın
EMBEDDING_DEVICE=mps

# --- ChromaDB (lokal, dosya sistemine persist eder) ---
CHROMA_PERSIST_DIR=./data/chroma_store
CHROMA_COLLECTION=noon_report_chunks

# --- Ollama (lokal LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.1

# --- Retrieval ---
RETRIEVAL_TOP_K=6
